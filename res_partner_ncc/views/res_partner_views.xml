<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 20 : la saisie se fait dans le widget natif d'identifiants (société en Côte d'Ivoire) ;
         ici seulement la recherche. -->
    <record id="view_res_partner_filter_ncc" model="ir.ui.view">
        <field name="name">res.partner.select.ncc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="ncc"/>
                <field name="rccm"/>
            </xpath>
        </field>
    </record>
</odoo>
