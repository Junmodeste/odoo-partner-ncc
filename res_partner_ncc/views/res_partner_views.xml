<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ncc" model="ir.ui.view">
        <field name="name">res.partner.form.ncc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="ncc" placeholder="e.g. 1234567A" invisible="not is_company"/>
                <field name="rccm" placeholder="e.g. CI-ABJ-2017-B-12345" invisible="not is_company"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_ncc" model="ir.ui.view">
        <field name="name">res.partner.select.ncc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="ncc"/>
                <field name="rccm"/>
            </xpath>
        </field>
    </record>
</odoo>
