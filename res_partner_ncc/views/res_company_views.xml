<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ncc" model="ir.ui.view">
        <field name="name">res.company.form.ncc</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="ncc" placeholder="e.g. 1234567A"/>
                <field name="rccm" placeholder="e.g. CI-ABJ-2017-B-12345"/>
            </xpath>
        </field>
    </record>
</odoo>
